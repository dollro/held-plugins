# Copy to .env on the server. Versions: set the current Traefik v3 minor
# (https://github.com/traefik/traefik/releases) and socket-proxy release
# (https://github.com/linuxserver/docker-socket-proxy/releases); never `latest`.
# Traefik 3.7.12 or later: earlier v3 releases lack aliasHeadersStrategy
# (CVE-2026-88879 / CVE-2026-88011).
TRAEFIK_VERSION=
SOCKET_PROXY_VERSION=
DASHBOARD_HOST=traefik.example.com
