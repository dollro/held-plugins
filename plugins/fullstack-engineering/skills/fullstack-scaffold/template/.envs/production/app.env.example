# Production secrets. Edit with `task secrets:edit ENV=production`; only the
# encrypted app.env.enc is committed. Non-secret deploy state lives in deploy.env.

# Label only (logs, error reports, banner); behaviour never depends on it.
APP_ENVIRONMENT=production
DJANGO_SETTINGS_MODULE=backend.config.settings.production
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=__APP_HOST__
DJANGO_CSRF_TRUSTED_ORIGINS=https://__APP_HOST__
DJANGO_ADMIN_URL=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

POSTGRES_DB=__PROJECT_SNAKE__
POSTGRES_USER=__PROJECT_SNAKE__
POSTGRES_PASSWORD=
DATABASE_URL=

# __Host- prefix: cookie bound to this exact host, Secure, path / (RFC 6265bis)
SESSION_COOKIE_NAME=__Host-sessionid

# Auth (audience: __AUTH_AUDIENCE__)
# >>> internal
# SSO is the way in for production; local login stays off.
LOCAL_LOGIN_ENABLED=False
# <<< internal
# >>> accounts
# Off: users are invited. On: anyone with a verified email can register.
SIGNUP_OPEN=False
MFA_REQUIRED=True
# <<< accounts
# >>> sso
# Company SSO over OpenID Connect (docs/operations.md, "Single sign-on").
# Entra ID: SSO_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_PROVIDER_ID=company
SSO_DISPLAY_NAME=Company login
SSO_AUTO_PROVISION=True
# Company-managed email domains (e.g. example.com): only these match existing accounts.
SSO_VERIFIED_EMAIL_DOMAINS=
# <<< sso

# smtp+tls://user:password@host:587
EMAIL_URL=
DEFAULT_FROM_EMAIL=noreply@__APP_HOST__

REDIS_URL=redis://redis:6379/0
INTERNAL_API_SECRET=
