# Deploy state: not secret, committed. Bump APP_VERSION in its own pull request,
# to a version that ran on staging; `git log -- .envs/production/deploy.env` is
# the production deploy history and a rollback is a revert of the bump.
APP_VERSION=
APP_HOST=__APP_HOST__
# Image registry; credentials come from the caller (docker login, CI secrets)
REGISTRY=
# Shared Traefik on the server (docs/operations.md, "Server setup"): its network
# and certificate resolver name
PROXY_NETWORK=proxy
TLS_CERTRESOLVER=letsencrypt
# Target host, reached over SSH by scripts/deploy.sh
DEPLOY_SSH_TARGET=
