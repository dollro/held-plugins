# Deploy target: not secret, committed. The version is not pinned here: the
# release pipeline deploys its own tag (task deploy ENV=staging VERSION=vX.Y.Z),
# and the CI platform's environment history records what runs.
APP_HOST=staging.__APP_HOST__
# Image registry; credentials come from the caller (docker login, CI secrets)
REGISTRY=
# Shared Traefik on the server (docs/operations.md, "Server setup"): its network
# and certificate resolver name
PROXY_NETWORK=proxy
TLS_CERTRESOLVER=letsencrypt
# Target host, reached over SSH by scripts/deploy.sh (may be the production host)
DEPLOY_SSH_TARGET=
