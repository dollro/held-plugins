# Local development. Safe to commit: generated by scripts/env_examples.py from the
# decrypted app.env, with external credentials blanked. Local infra values stay
# so a new developer can boot the stack before they can decrypt anything.

# Django
APP_ENVIRONMENT=local
DJANGO_SETTINGS_MODULE=backend.config.settings.local
DJANGO_SECRET_KEY=local-dev-only-not-secret
DJANGO_DEBUG=True
DJANGO_VITE_DEV_MODE=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django,proxy
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=admin-local-only

# Postgres (the postgres image reads POSTGRES_*; the apps read DATABASE_URL)
POSTGRES_DB=__PROJECT_SNAKE__
POSTGRES_USER=__PROJECT_SNAKE__
POSTGRES_PASSWORD=local-dev-only
DATABASE_URL=postgres://__PROJECT_SNAKE__:local-dev-only@postgres:5432/__PROJECT_SNAKE__

# Redis / Celery
REDIS_URL=redis://redis:6379/0
FLOWER_USER=admin
FLOWER_PASSWORD=local-dev-only

# Service-to-service
INTERNAL_API_SECRET=local-dev-only-internal-secret
# >>> realtime
DJANGO_INTERNAL_URL=http://django:5000
REALTIME_DEBUG=True
# <<< realtime

# Auth (audience: __AUTH_AUDIENCE__)
# >>> internal
LOCAL_LOGIN_ENABLED=True
# <<< internal
# >>> accounts
SIGNUP_OPEN=True
MFA_REQUIRED=False
# <<< accounts
# >>> sso
# Company SSO (OpenID Connect): active only when issuer, client ID and secret are set.
# Entra ID: SSO_ISSUER_URL=https://login.microsoftonline.com/<tenant-id>/v2.0
SSO_ISSUER_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_VERIFIED_EMAIL_DOMAINS=
# <<< sso

# Email
# >>> accounts
EMAIL_URL=smtp://mailpit:1025
# <<< accounts
# >>> !accounts
EMAIL_URL=consolemail://
# <<< !accounts

# External services (blanked in the example; fill in app.env, never here)
# EXAMPLE_PROVIDER_API_KEY=
