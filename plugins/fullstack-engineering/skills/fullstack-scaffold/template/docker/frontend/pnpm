#!/usr/bin/env bash
# Run pnpm inside a plain node image: install the pnpm version pinned in
# package.json ("packageManager"), sync node_modules with the lockfile, run.
#
# The container runs as root, so every file it writes into the bind-mounted
# repo (build output, test reports) is handed back to the host user on exit.
# The pnpm store lives inside the node_modules volume, never in the repo.
set -uo pipefail
cd /app/frontend
export pnpm_config_store_dir=/app/frontend/node_modules/.pnpm-store

give_back() {
  chown -R "${HOST_UID:-1000}:${HOST_GID:-1000}" \
    /app/backend/static/vue /app/frontend/playwright-report /app/frontend/test-results \
    /app/frontend/e2e-results.xml /app/frontend/pnpm-lock.yaml /app/frontend/package.json \
    2>/dev/null || true
}
trap give_back EXIT

PNPM_VERSION="$(node -p "require('./package.json').packageManager.split('@')[1]")"
if [ "$(pnpm --version 2>/dev/null || true)" != "${PNPM_VERSION}" ]; then
  npm install -g --silent "pnpm@${PNPM_VERSION}" || exit 1
fi
CI=true pnpm install --frozen-lockfile --prefer-offline >/dev/null || exit 1
pnpm "$@"
