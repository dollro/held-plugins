#!/usr/bin/env bash
set -euo pipefail
# Migrations are a separate deploy step (scripts/deploy.sh migrate), never on start.
# No control socket: the production root filesystem is read-only (gunicorn >= 26).
exec gunicorn backend.config.wsgi \
  --bind 0.0.0.0:5000 \
  --workers "${GUNICORN_WORKERS:-3}" \
  --access-logfile - \
  --no-control-socket \
  --forwarded-allow-ips '*'
